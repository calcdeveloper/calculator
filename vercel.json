{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd next-calculators && npm ci && npm run build",
  "outputDirectory": "next-calculators/out",
  "installCommand": "cd next-calculators && npm ci",
  "framework": null,
  "env": {
    "NEXT_PUBLIC_SITE_URL": "https://toolswizard.in"
  },
  "redirects": [
    {
      "source": "/tools/json-tools",
      "destination": "/tools/developer-tools",
      "permanent": true
    },
    {
      "source": "/tools/json-tools/:path*",
      "destination": "/tools/developer-tools/:path*",
      "permanent": true
    }
  ]
}
